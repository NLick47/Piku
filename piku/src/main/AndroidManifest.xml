<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <queries>
        <package android:name="com.tencent.mm" />
        <package android:name="com.tencent.mobileqq" />
    </queries>

    <application
        android:name=".PoipikuApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Poipiku"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 站内深链：host 清单来自各源的 SourceLinkParser.hosts（domain/source），path 只登记
                 解析器真正能打开的页面形态。PatternMatcher 不支持 [0-9] 字符类，数字段只能用 .* 宽匹配，
                 多余形态由解析器拒绝后落首页兜底；pixiv 小说页的 query（?id=）不参与 path 匹配 -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- poipiku：作品页（/{作者}/{作品}.html）与作者页（/{作者}/ 或 /{作者}.html） -->
                <data android:scheme="https" android:host="poipiku.com" android:pathPattern="/.*\\.html" />
                <data android:scheme="https" android:host="poipiku.com" android:pathPattern="/.*/" />
                <data android:scheme="https" android:host="www.poipiku.com" android:pathPattern="/.*\\.html" />
                <data android:scheme="https" android:host="www.poipiku.com" android:pathPattern="/.*/" />
                <data android:scheme="https" android:host="m.poipiku.com" android:pathPattern="/.*\\.html" />
                <data android:scheme="https" android:host="m.poipiku.com" android:pathPattern="/.*/" />
                <!-- pixiv：插画/漫画、小说、作者页（容忍 /en 前缀），其余路径留给浏览器 -->
                <data android:scheme="https" android:host="pixiv.net" android:pathPattern="/artworks/.*" />
                <data android:scheme="https" android:host="pixiv.net" android:pathPattern="/en/artworks/.*" />
                <data android:scheme="https" android:host="pixiv.net" android:pathPattern="/novel/show\\.php" />
                <data android:scheme="https" android:host="pixiv.net" android:pathPattern="/en/novel/show\\.php" />
                <data android:scheme="https" android:host="pixiv.net" android:pathPattern="/users/.*" />
                <data android:scheme="https" android:host="pixiv.net" android:pathPattern="/en/users/.*" />
                <data android:scheme="https" android:host="www.pixiv.net" android:pathPattern="/artworks/.*" />
                <data android:scheme="https" android:host="www.pixiv.net" android:pathPattern="/en/artworks/.*" />
                <data android:scheme="https" android:host="www.pixiv.net" android:pathPattern="/novel/show\\.php" />
                <data android:scheme="https" android:host="www.pixiv.net" android:pathPattern="/en/novel/show\\.php" />
                <data android:scheme="https" android:host="www.pixiv.net" android:pathPattern="/users/.*" />
                <data android:scheme="https" android:host="www.pixiv.net" android:pathPattern="/en/users/.*" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>